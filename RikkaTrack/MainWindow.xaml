<Window x:Class="RikkaTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RikkaTrack"
        xmlns:vm="clr-namespace:RikkaTrack.ViewModels"
        xmlns:views="clr-namespace:RikkaTrack.Views"
        mc:Ignorable="d"
        Title="RikkaTrack" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="0" CornerRadius="15"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        
        <!-- Sidebar Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushPurpleShadow}" CornerRadius="15" BorderBrush="{StaticResource BrushPurple}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushPurple}" CornerRadius="15,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/> <!-- Logo Area -->
                        <RowDefinition Height="*"/>   <!-- Nav Area -->
                        <RowDefinition Height="Auto"/> <!-- Status Area -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="RikkaTrack" Style="{StaticResource TitleText}" Foreground="White"/>
                        <TextBlock Text="TIME TRACKER" FontSize="10" Foreground="#BBBBBB" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="10,20">
                        <Button Content="概览" Style="{StaticResource NavButton}" Command="{Binding NavigateToDashboardCommand}"/>
                        <Button Content="应用统计" Style="{StaticResource NavButton}" Margin="0,5,0,0"/>
                        <Button Content="网页统计" Style="{StaticResource NavButton}" Margin="0,5,0,0"/>
                        <Button Content="设置" Style="{StaticResource NavButton}" Margin="0,5,0,0" Command="{Binding NavigateToSettingsCommand}"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#22000000" Padding="15" CornerRadius="0,0,0,15">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#88FFFFFF" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Custom Titlebar Area -->
                    <RowDefinition Height="*"/>  <!-- Page Content -->
                </Grid.RowDefinitions>

                <!-- Custom Titlebar Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="0" FontFamily="Marlett" Background="Transparent" Foreground="White" BorderThickness="0" Width="40" Click="MinimizeButton_Click"/>
                    <Button Content="r" FontFamily="Marlett" Background="Transparent" Foreground="White" BorderThickness="0" Width="40" Click="CloseButton_Click"/>
                </StackPanel>

                <!-- Page Host -->
                <ContentPresenter Grid.Row="1" Content="{Binding CurrentViewModel}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
