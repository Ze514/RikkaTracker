<UserControl x:Class="RikkaTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <!-- @Author: trae + deepseek-V4-pro -->
    <!-- @Date: 2026-06-23 -->
    <!-- @Desc: Segoe Fluent Icons 字体资源，用于 FontIcon 标记扩展 -->
    <UserControl.Resources>
        <FontFamily x:Key="SegoeFluentIcons">Segoe Fluent Icons</FontFamily>
    </UserControl.Resources>
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <ui:TextBlock Text="{DynamicResource StrSettings}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <ui:Card Padding="10" Margin="0,0,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrIdleTimeout}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrIdleTimeoutDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding IdleTimeoutMinutes}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Slider Value="{Binding IdleTimeoutMinutes}" Minimum="1" Maximum="60" Width="100"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrAutoStart}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrAutoStartDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStart}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrDarkMode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrDarkModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrZoomMode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrZoomModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding TimelineZoomMode}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrZoomModeCenter}" Tag="Center"/>
                            <ComboBoxItem Content="{DynamicResource StrZoomModeLatest}" Tag="Latest"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrLanguage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrLanguageDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrLanguageAuto}" Tag="Auto"/>
                            <ComboBoxItem Content="{DynamicResource StrLanguageZh}" Tag="zh-CN"/>
                            <ComboBoxItem Content="{DynamicResource StrLanguageEn}" Tag="en-US"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrDisplayMode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrDisplayModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding DisplayMode}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrDisplayModeAppOnly}" Tag="AppOnly"/>
                            <ComboBoxItem Content="{DynamicResource StrDisplayModeWebOnly}" Tag="WebOnly"/>
                            <ComboBoxItem Content="{DynamicResource StrDisplayModeCombined}" Tag="Combined"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrTimelineSortMode}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrTimelineSortModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding TimelineSortMode}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrSortByDuration}" Tag="Duration"/>
                            <ComboBoxItem Content="{DynamicResource StrSortByRecency}" Tag="Recency"/>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrRowBadges}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrRowBadgesDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRowBadges}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- @Author: trae + deepseek-V4-pro -->
            <!-- @Date: 2026-06-23 -->
            <!-- @Desc: 浏览器监控独立卡片 -->
            <ui:Card Padding="10" Margin="0,15,0,0">
                <StackPanel>
                    <!-- 标题行：浏览器监控开关 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitor}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding WebMonitorEnabled}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 展开/折叠安装指引的按钮（收起时 ▼，展开时 ▲） -->
                    <ui:Button Margin="0,10,0,0" 
                               Command="{Binding ToggleInstallGuideCommand}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorInstallGuide}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text=" ▼" VerticalAlignment="Center"
                                           Visibility="{Binding IsInstallGuideExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ui:TextBlock Text=" ▲" VerticalAlignment="Center"
                                           Visibility="{Binding IsInstallGuideExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- 安装指引详细内容（默认折叠，展开后可见） -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsInstallGuideExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 方式一：从商店获取 -->
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorGetFromStore}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource StrBrowserMonitorChromeStore}" 
                                           Command="{Binding OpenChromeStoreCommand}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ui:Button Content="{DynamicResource StrBrowserMonitorEdgeStore}" 
                                           Command="{Binding OpenEdgeStoreCommand}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 视觉分隔 -->
                        <Rectangle Height="1" Fill="{ui:ThemeResource ControlFillColorDefaultBrush}" Margin="0,0,0,10"/>

                        <!-- 方式二：手动安装步骤 -->
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualTitle}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualStep1}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualStep2}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualStep3}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualStep4}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="{DynamicResource StrBrowserMonitorManualStep5}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <ui:Button Content="{DynamicResource StrBrowserMonitorOpenRelease}" 
                                       Command="{Binding OpenGitHubReleaseCommand}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="10" Margin="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="{DynamicResource StrUpdate}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ui:TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{DynamicResource StrCurrentVersion}"/>: <Run Text="{Binding CurrentVersion}"/>
                        </ui:TextBlock>
                        
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsUpdating, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{ui:ThemeResource SystemFillColorSuccessBrush}" Margin="0,0,0,0"/>
                            <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Height="4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- @Desc: CloudDownload → \uE9F5 (Segoe Fluent Icons) -->
                    <ui:Button Grid.Column="1" 
                               Content="{DynamicResource StrCheckUpdate}" 
                               Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE9F5;}" 
                               Command="{Binding CheckForUpdateCommand}"
                               IsEnabled="{Binding IsUpdating, Converter={StaticResource InverseBooleanConverter}}"
                               VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
            
            <ui:Card Padding="10" Margin="0,15,0,0">
                <StackPanel>
                    <!-- 数据存储路径 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrDataStorage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{Binding StoragePath}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- @Desc: Folder → \uE838 (Segoe Fluent Icons) -->
                        <ui:Button Grid.Column="1" 
                                   Content="{DynamicResource StrChange}" 
                                   Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xE838;}" 
                                   Command="{Binding ChangeStoragePathCommand}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                
                    <!-- 日志管理 -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrLogManagement}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="{DynamicResource StrLogManagementDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- @Desc: DeveloperBoard → \uEC48 (Segoe Fluent Icons) -->
                            <ui:Button Content="{DynamicResource StrOpenDiagnosticConsole}" 
                                       Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xEC48;}" 
                                       Command="{Binding OpenDiagnosticConsoleCommand}"
                                       Margin="0,0,10,0"/>
                            <!-- @Desc: FolderOpen → \uED25 (Segoe Fluent Icons) -->
                            <ui:Button Content="{DynamicResource StrOpenLogFolder}" 
                                       Icon="{ui:FontIcon FontFamily={StaticResource SegoeFluentIcons}, Glyph=&#xED25;}" 
                                       Command="{Binding OpenLogFolderCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
