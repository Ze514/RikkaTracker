<UserControl x:Class="RikkaTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <ui:TextBlock Text="{DynamicResource StrSettings}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <ui:Card Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrIdleTimeout}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{DynamicResource StrIdleTimeoutDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding IdleTimeoutMinutes}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Slider Value="{Binding IdleTimeoutMinutes}" Minimum="1" Maximum="60" Width="100"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrAutoStart}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{DynamicResource StrAutoStartDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStart}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrDarkMode}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{DynamicResource StrDarkModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrZoomMode}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{DynamicResource StrZoomModeDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding TimelineZoomMode}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrZoomModeCenter}" Tag="Center"/>
                            <ComboBoxItem Content="{DynamicResource StrZoomModeLatest}" Tag="Latest"/>
                        </ComboBox>
                    </Grid>
                    
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="{DynamicResource StrLanguage}" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{DynamicResource StrLanguageDesc}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding Language}" SelectedValuePath="Tag" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource StrLanguageAuto}" Tag="Auto"/>
                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Text="{DynamicResource StrFilterRules}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
            <ui:Card Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ItemsControl ItemsSource="{Binding FilterRules}" 
                                  BorderThickness="0" 
                                  Background="Transparent" 
                                  Margin="0,0,0,10"
                                  d:ItemsSource="{d:SampleData ItemCount=3}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ui:TextBox Text="{Binding ProcessPattern, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="进程名 (支持 *)" Margin="0,0,10,0"/>
                                    
                                    <CheckBox Grid.Column="1" Content="{DynamicResource StrIgnoreRecord}" IsChecked="{Binding Ignore}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" Content="{DynamicResource StrDisableIdle}" IsChecked="{Binding DisableIdleDetection}" VerticalAlignment="Center"/>
                                    
                                    <ui:Button Grid.Column="3" 
                                               Icon="{ui:SymbolIcon Delete24}" 
                                               Appearance="Transparent" 
                                               Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="{DynamicResource StrAddRule}" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddRuleCommand}"/>
                        <ui:Button Content="{DynamicResource StrSaveAndApply}" Appearance="Primary" Margin="10,0,0,0" Command="{Binding SaveRulesCommand}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="{DynamicResource StrDataStorage}" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="{Binding StoragePath}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" 
                               Content="{DynamicResource StrChange}" 
                               Icon="{ui:SymbolIcon Folder24}" 
                               Command="{Binding ChangeStoragePathCommand}"
                               VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
            
            <ui:Button Content="{DynamicResource StrExportData}" 
                       Appearance="Primary" 
                       Margin="0,20,0,0" 
                       Padding="20,10"
                       Icon="{ui:SymbolIcon Share24}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
