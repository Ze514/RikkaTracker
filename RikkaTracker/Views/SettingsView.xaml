<UserControl x:Class="RikkaTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <ui:TextBlock Text="设置" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <ui:Card Padding="20" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="空闲超时 (分钟)" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="在此时间后无操作，活跃应用将标记为非活动状态" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding IdleTimeoutMinutes}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Slider Value="{Binding IdleTimeoutMinutes}" Minimum="1" Maximum="60" Width="100"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="开机自启动" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="随系统启动自动进入监控状态" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStart}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="深色模式" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="切换应用的主题风格" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock Text="应用策略规则" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
            <ui:Card Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ItemsControl ItemsSource="{Binding FilterRules}" 
                                  BorderThickness="0" 
                                  Background="Transparent" 
                                  Margin="0,0,0,10"
                                  d:ItemsSource="{d:SampleData ItemCount=3}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ui:TextBox Text="{Binding ProcessPattern, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="进程名 (支持 *)" Margin="0,0,10,0"/>
                                    
                                    <CheckBox Grid.Column="1" Content="忽略记录" IsChecked="{Binding Ignore}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" Content="免空闲检测" IsChecked="{Binding DisableIdleDetection}" VerticalAlignment="Center"/>
                                    
                                    <ui:Button Grid.Column="3" 
                                               Icon="{ui:SymbolIcon Delete24}" 
                                               Appearance="Transparent" 
                                               Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="新增规则" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddRuleCommand}"/>
                        <ui:Button Content="保存并生效" Appearance="Primary" Margin="10,0,0,0" Command="{Binding SaveRulesCommand}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="数据存储路径" VerticalAlignment="Center"/>
                        <ui:TextBlock Text="{Binding StoragePath}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" 
                               Content="更改" 
                               Icon="{ui:SymbolIcon Folder24}" 
                               Command="{Binding ChangeStoragePathCommand}"
                               VerticalAlignment="Center"/>
                </Grid>
            </ui:Card>
            
            <ui:Button Content="导出全部数据" 
                       Appearance="Primary" 
                       Margin="0,20,0,0" 
                       Padding="20,10"
                       Icon="{ui:SymbolIcon Share24}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
