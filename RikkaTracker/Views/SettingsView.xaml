<UserControl x:Class="RikkaTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="20">
        <StackPanel>
            <ui:TextBlock Text="设置" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <ui:Card Padding="20" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="通用设置" FontSize="18" FontWeight="SemiBold"/>
                        <ui:TextBlock Text="配置软件的基础运行行为" FontSize="12" Foreground="#88FFFFFF"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="开机自启动" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="随系统启动自动进入监控状态" FontSize="12" Foreground="#88FFFFFF"/>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsAutoStart}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:TextBlock Text="数据存储路径" VerticalAlignment="Center"/>
                            <ui:TextBlock Text="{Binding StoragePath}" FontSize="12" Foreground="#88FFFFFF"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="更改" Icon="{ui:SymbolIcon Folder24}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
            
            <ui:Button Content="导出全部数据" 
                       Appearance="Primary" 
                       Margin="0,20,0,0" 
                       Padding="20,10"
                       Icon="{ui:SymbolIcon Share24}"/>
        </StackPanel>
    </Grid>
</UserControl>
