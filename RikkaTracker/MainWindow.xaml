<ui:FluentWindow x:Class="RikkaTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RikkaTracker"
        xmlns:vm="clr-namespace:RikkaTracker.ViewModels"
        xmlns:views="clr-namespace:RikkaTracker.Views"
        mc:Ignorable="d"
        Title="RikkaTracker" Height="750" Width="1200"
        Icon="Assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityListViewModel}">
            <views:ActivityListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageStatisticsViewModel}">
            <views:UsageStatisticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilterSettingsViewModel}">
            <views:FilterSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app-icon.png" Width="33" Height="33" VerticalAlignment="Center" />
                    <TextBlock Text="RikkaTracker" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                Grid.Column="0"
                HorizontalAlignment="Left"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="True"
                OpenPaneLength="200">
                
                <ui:NavigationView.PaneHeader>
                    <StackPanel Margin="12,8,12,12">
                        <ui:TextBlock Text="View Mode" FontSize="11" Margin="0,0,0,4"
                                      Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox SelectedValue="{Binding DisplayMode, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Tag="AppOnly" Content="Only Apps"/>
                            <ComboBoxItem Tag="WebOnly" Content="Only Web"/>
                            <ComboBoxItem Tag="Combined" Content="Combined"/>
                        </ComboBox>
                    </StackPanel>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrDashboard}"
                        Command="{Binding NavigateToDashboardCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrActiveApps}"
                        Command="{Binding NavigateToActivityListCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Apps24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrTimeline}"
                        Command="{Binding NavigateToStatisticsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Clock24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrUsageStatistics}"
                        Command="{Binding NavigateToUsageStatisticsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DataBarVertical24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrFilterRules}"
                        Command="{Binding NavigateToFilterSettingsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Shield24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        Content="{DynamicResource StrExport}"
                        Command="{Binding NavigateToExportCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowExportUp24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Content="{DynamicResource StrSettings}"
                        Command="{Binding NavigateToSettingsCommand}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <ContentPresenter Grid.Column="1" Margin="10" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
